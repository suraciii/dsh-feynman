{
  "name": "@maci0/dsh-feynman",
  "version": "0.24.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "index.js",
  "description": "Feynman-style research workflows for DeepSeek Harness behind one /feynman command (deepresearch, review, audit, review-loop, \u2026)",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "index.js",
    "prompts.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/upstream-20261013.md",
    "LICENSE",
    "NOTICE",
    "lib/*.js",
    "vendor/upstream/LICENSE",
    "upstream.manifest.json",
    "lib/*.mjs",
    "vendor/docparser/LICENSE",
    "resources/",
    "RELEASES.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:node": "node --test tests/*.test.*",
    "build": "bun build vendor/upstream/entry.ts --target=node --packages=external --outfile lib/upstream.js"
  },
  "engines": {
    "node": "^22.22.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maci0/dsh-feynman.git"
  },
  "icon": "./icon.svg",
  "dependencies": {
    "@companion-ai/alpha-hub": "0.1.7",
    "@deepseek-ai/schemastery": "3.18.5",
    "@llamaindex/liteparse": "2.10.1",
    "fast-xml-parser": "5.11.1",
    "typebox": "1.3.37"
  }
}
